{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["${mod_author}"],
    "license": "${mod_license}",
    "environment": "*",
    "mixins": ["mismatchedleggings.mixins.json", "mismatchedleggings.fabric.mixins.json"],
    "entrypoints": {
        "main": ["games.alejandrocoria.mismatchedleggings.MismatchedLeggingsFabric"],
        "client": ["games.alejandrocoria.mismatchedleggings.client.MismatchedLeggingsClientFabric"]
    },
    "contact": { "sources": "${mod_sources}", "issues": "${mod_issues}" },
    "depends": {
        "mismatchedthings": ">=1.1.0 <2.0.0",
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": ">=${fabric_api_min_version}",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
