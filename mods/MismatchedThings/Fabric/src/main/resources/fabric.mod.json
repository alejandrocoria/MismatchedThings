{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["${mod_author}"],
    "license": "${mod_license}",
    "environment": "*",
    "accessWidener": "mismatchedthings.accesswidener",
    "entrypoints": {
        "main": ["games.alejandrocoria.mismatchedthings.MismatchedThingsFabric"],
        "client": ["games.alejandrocoria.mismatchedthings.client.MismatchedThingsClientFabric"]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": ">=${fabric_api_min_version}",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
