{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "email": "${mod_email}",
        "homepage": "${mod_homepage}",
        "issues": "${mod_issues}",
        "sources": "${mod_sources}"
    },

    "license": "${mod_license}",
    "icon": "${mod_logo}",

    "environment": "*",
    "accessWidener": "mismatchedboots.accesswidener",
    "entrypoints": {
        "main": [
            "games.alejandrocoria.mismatchedboots.MismatchedBootsFabric"
        ],
        "client": [
            "games.alejandrocoria.mismatchedboots.client.MismatchedBootsClientFabric"
        ]
    },

    "mixins": [
        "mismatchedboots.mixins.json",
        "mismatchedboots.fabric.mixins.json",
        "mismatchedboots.betterx.mixins.json",
        "mismatchedboots.client.mixins.json"
    ],

    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "commonnetworking": ">=${common_networking_version}",
        "minecraft": "~${minecraft_version}",
        "java": ">=${java_version}"
    }
}
